rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    match /companies/{companyId} {
      allow read, write, delete: if isSignedIn();
    }

    match /users/{userId} {
      allow read, write, delete: if isSignedIn();
    }

    match /staff/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /transactions/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /journal/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /payments/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /buyer_payments/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /bag_transactions/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /suppliers/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /buyers/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /store_records/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /warehouses/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /attendance/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /rosters/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /payrolls/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /audit_logs/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /inventory_adjustments/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /petty_cash/{id} {
      allow read, write, delete: if isSignedIn();
    }

    match /test/connection {
      allow read, write: if isSignedIn();
    }

    match /_health_check_/ping {
      allow read: if true;
    }
  }
}

