rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Helpers
    // ===============================================================
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function getEmail() { return request.auth.token.get('email', '').lower(); }
    
    // Super Admins bypass many checks
    function isSuperAdmin() {
      return isSignedIn() && (
        getEmail() == "wasiuadebisi89@gmail.com" || 
        getEmail() == "adezmoldent@gmail.com" || 
        getEmail() == "abdullahiwasiu07@gmail.com"
      );
    }

    function getUserData() {
      let uid = request.auth.token.firebase.sign_in_provider == 'anonymous' ? 'demo_admin_profile_local' : request.auth.uid;
      let path = /databases/$(database)/documents/users/$(uid);
      let legacyPath = /databases/$(database)/documents/users/demo_admin_profile;
      return exists(path) ? get(path).data : (exists(legacyPath) ? get(legacyPath).data : null);
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function sameCompany(companyId) {
      let data = getUserData();
      return isSignedIn() && (
        isSuperAdmin() || 
        (isAnonymous() && (companyId == 'demo_company' || companyId == 'demo_company_local')) || 
        (data != null && data.companyId == companyId)
      );
    }

    function hasRole(allowedRoles) {
      let data = getUserData();
      return isSignedIn() && (
        isSuperAdmin() ||
        isAnonymous() ||
        (data != null && data.role in allowedRoles)
      );
    }

    function isAdmin() {
      return hasRole(['ADMIN']);
    }

    function isManager() {
      return hasRole(['ADMIN', 'MANAGER']);
    }

    function isAccount() {
      return hasRole(['ADMIN', 'MANAGER', 'ACCOUNT']);
    }

    function isAuditor() {
      return hasRole(['ADMIN', 'MANAGER', 'AUDITOR']);
    }

    function isStaff() {
      return hasRole(['ADMIN', 'MANAGER', 'ACCOUNT', 'AUDITOR', 'STAFF', 'STORE_KEEPER']);
    }

    function isStoreKeeper() {
      return hasRole(['ADMIN', 'STORE_KEEPER']);
    }

    // Soft delete helper
    function isSoftDelete() {
      return incoming().get('isDeleted', false) == true && 
             incoming().keys().hasAll(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt']) &&
             incoming().deletionReason is string && incoming().deletionReason.size() > 0 &&
             incoming().deletedBy == getEmail() &&
             incoming().deletedAt is string;
    }

    // ===============================================================
    // Entity Validators (The Blueprints)
    // ===============================================================

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'companyId', 'date', 'type', 'commodity', 'netWeight', 'deductions']) &&
             data.id is string && data.companyId is string &&
             data.type in ['PURCHASE', 'SALE', 'TRANSFER', 'PURCHASE_RETURN', 'SALES_RETURN'] &&
             data.commodity is string && data.commodity.size() > 0 &&
             data.netWeight is number && data.netWeight >= 0 &&
             data.deductions is map;
    }

    function isValidInventoryAdjustment(data) {
      return data.keys().hasAll(['id', 'companyId', 'date', 'postingDate', 'commodity', 'warehouseId', 'adjustmentType', 'adjustmentDirection', 'netWeight', 'bags', 'createdBy', 'creatorEmail']) &&
             data.id is string && data.companyId is string &&
             data.commodity is string && data.commodity.size() > 0 &&
             data.adjustmentType in ['WEIGHT_LOSS', 'DAMAGED_STOCK', 'SPOILAGE', 'THEFT_LOSS', 'STOCK_COUNT', 'QUALITY_TEST', 'INTERNAL_USE'] &&
             data.adjustmentDirection in ['ADD', 'REMOVE'] &&
             data.netWeight is number && data.netWeight >= 0 &&
             data.bags is number && data.bags >= 0;
    }

    function isValidJournalEntry(data) {
      return data.keys().hasAll(['id', 'companyId', 'warehouseId', 'date', 'type', 'category', 'amount']) &&
             data.type in ['INFLOW', 'OUTFLOW'] &&
             data.amount is number && data.amount >= 0;
    }

    function isValidPettyCash(data) {
      return data.keys().hasAll(['id', 'companyId', 'warehouseId', 'date', 'postingDate', 'type', 'amount', 'category', 'status', 'createdBy', 'creatorEmail']) &&
             data.type in ['DISBURSEMENT', 'EXPENSE'] &&
             data.status in ['PENDING', 'RETIRED'] &&
             data.amount is number && data.amount >= 0;
    }

    function isValidStoreRecord(data) {
      return data.keys().hasAll(['id', 'companyId', 'date', 'type', 'customerName', 'nominalWeight', 'actualWeight', 'noOfBags']) &&
             data.type in ['IN', 'OUT', 'TRANSFER'] &&
             data.actualWeight is number && data.actualWeight >= 0;
    }

    function isValidSupplier(data) {
      return data.keys().hasAll(['id', 'companyId', 'name']) &&
             data.name is string && data.name.size() > 0;
    }

    function isValidBuyer(data) {
      return data.keys().hasAll(['id', 'companyId', 'name']) &&
             data.name is string && data.name.size() > 0;
    }

    function isValidBuyerPayment(data) {
      return data.keys().hasAll(['id', 'companyId', 'warehouseId', 'date', 'buyerId', 'amount']) &&
             data.id is string && data.companyId is string &&
             data.buyerId is string && data.amount is number && data.amount >= 0;
    }

    // ===============================================================
    // Match Blocks
    // ===============================================================

    match /companies/{companyId} {
      allow read: if sameCompany(companyId);
      allow create: if isSuperAdmin() || (isSignedIn() && incoming().ownerEmail == getEmail()) || (isAnonymous() && companyId == 'demo_company');
      allow update: if (isAdmin() && sameCompany(companyId)) || (isAnonymous() && companyId == 'demo_company');
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || userId == 'demo_admin_profile' || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid == userId || (userId == 'demo_admin_profile' && isAnonymous()));
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().role == existing().role) ||
        (isAdmin() && sameCompany(existing().get('companyId', ''))) ||
        (userId == 'demo_admin_profile' && isAnonymous())
      );
      allow delete: if isSuperAdmin() || (isAdmin() && sameCompany(existing().get('companyId', '')));
    }

    match /transactions/{id} {
      allow list: if isStaff() && sameCompany(resource.data.companyId); // Enforced query
      allow get: if isStaff() && sameCompany(existing().companyId);
      allow create: if isStaff() && sameCompany(incoming().companyId) && isValidTransaction(incoming());
      allow update: if sameCompany(existing().companyId) && (
        (isAdmin() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isStaff() && isValidTransaction(incoming()))
      );
      allow delete: if false; // Prefer soft delete
    }

    match /journal/{id} {
      allow list: if isStaff() && sameCompany(resource.data.companyId);
      allow get: if isStaff() && sameCompany(existing().companyId);
      allow create: if isStaff() && sameCompany(incoming().companyId) && isValidJournalEntry(incoming());
      allow update: if sameCompany(existing().companyId) && (
        (isAdmin() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isStaff() && isValidJournalEntry(incoming()))
      );
      allow delete: if false;
    }

    match /payments/{id} {
      allow list: if isStaff() && sameCompany(resource.data.companyId);
      allow get: if isStaff() && sameCompany(existing().companyId);
      allow create: if isStaff() && sameCompany(incoming().companyId);
      allow update: if sameCompany(existing().companyId) && (
        (isAdmin() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isStaff())
      );
    }

    match /buyer_payments/{id} {
      allow list: if isStaff() && sameCompany(resource.data.companyId);
      allow get: if isStaff() && sameCompany(existing().companyId);
      allow create: if isStaff() && sameCompany(incoming().companyId) && isValidBuyerPayment(incoming());
      allow update: if sameCompany(existing().companyId) && (
        (isAdmin() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isStaff() && isValidBuyerPayment(incoming()))
      );
    }

    match /bag_transactions/{id} {
      allow list: if isStaff() && sameCompany(resource.data.companyId);
      allow get: if isStaff() && sameCompany(existing().companyId);
      allow create: if isStaff() && sameCompany(incoming().companyId);
      allow update: if sameCompany(existing().companyId) && (
        (isAdmin() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isStaff())
      );
    }

    match /suppliers/{id} {
      allow list: if isStaff() && sameCompany(resource.data.companyId);
      allow get: if isStaff() && sameCompany(existing().companyId);
      allow create: if isStaff() && sameCompany(incoming().companyId) && isValidSupplier(incoming());
      allow update: if sameCompany(existing().companyId) && (
        (isAdmin() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isStaff() && isValidSupplier(incoming()))
      );
    }

    match /buyers/{id} {
      allow list: if isStaff() && sameCompany(resource.data.companyId);
      allow get: if isStaff() && sameCompany(existing().companyId);
      allow create: if isStaff() && sameCompany(incoming().companyId) && isValidBuyer(incoming());
      allow update: if sameCompany(existing().companyId) && (
        (isAdmin() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isStaff() && isValidBuyer(incoming()))
      );
    }

    match /store_records/{id} {
      allow list: if (isStoreKeeper() || isManager()) && sameCompany(resource.data.companyId);
      allow get: if (isStoreKeeper() || isManager()) && sameCompany(existing().companyId);
      allow create: if isStoreKeeper() && sameCompany(incoming().companyId) && isValidStoreRecord(incoming());
      allow update: if sameCompany(existing().companyId) && (
        (isManager() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isStoreKeeper() && isValidStoreRecord(incoming()))
      );
    }

    match /staff/{id} {
      allow list: if (isManager() && sameCompany(resource.data.companyId)) || (isSignedIn() && resource.data.email.lower() == getEmail());
      allow get: if (isManager() && sameCompany(existing().companyId)) || (isSignedIn() && existing().email.lower() == getEmail());
      allow create: if isManager() && sameCompany(incoming().companyId);
      allow update: if (isManager() && sameCompany(existing().companyId)) || (isSignedIn() && existing().email.lower() == getEmail() && (incoming().diff(existing()).affectedKeys().hasOnly(['uid'])));
      allow delete: if isManager() && sameCompany(existing().companyId);
    }

    match /warehouses/{id} {
      allow list: if isStaff() && sameCompany(resource.data.companyId);
      allow get: if isStaff() && sameCompany(existing().companyId);
      allow create: if isAdmin() && sameCompany(incoming().companyId);
      allow update: if (isAdmin() && sameCompany(existing().companyId)) || (isAnonymous() && id == 'demo_warehouse_1');
      allow delete: if isAdmin() && sameCompany(existing().companyId);
    }

    match /attendance/{id} {
      allow list: if (isManager() || isStaff()) && sameCompany(resource.data.companyId);
      allow get: if (isManager() || isStaff()) && sameCompany(existing().companyId);
      allow create: if isManager() && sameCompany(incoming().companyId);
      allow update: if isManager() && sameCompany(existing().companyId);
      allow delete: if isAdmin() && sameCompany(existing().companyId);
    }

    match /rosters/{id} {
      allow list: if (isManager() || isStaff()) && sameCompany(resource.data.companyId);
      allow get: if (isManager() || isStaff()) && sameCompany(existing().companyId);
      allow create: if isManager() && sameCompany(incoming().companyId);
      allow update: if isManager() && sameCompany(existing().companyId);
      allow delete: if isAdmin() && sameCompany(existing().companyId);
    }

    match /payrolls/{id} {
      allow list: if (isAdmin() || isAccount()) && sameCompany(resource.data.companyId);
      allow get: if (isAdmin() || isAccount()) && sameCompany(existing().companyId);
      allow create: if (isAdmin() || isAccount()) && sameCompany(incoming().companyId);
      allow update: if (isAdmin() || isAccount()) && sameCompany(existing().companyId);
      allow delete: if isAdmin() && sameCompany(existing().companyId);
    }

    match /audit_logs/{id} {
      allow list: if (isManager() || isAuditor()) && sameCompany(resource.data.companyId);
      allow create: if isSignedIn() && sameCompany(incoming().companyId);
    }

    match /inventory_adjustments/{id} {
      allow list: if isStaff() && sameCompany(resource.data.companyId);
      allow get: if isStaff() && sameCompany(existing().companyId);
      allow create: if isStaff() && sameCompany(incoming().companyId) && isValidInventoryAdjustment(incoming());
      allow update: if sameCompany(existing().companyId) && (
        (isAdmin() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isStaff() && isValidInventoryAdjustment(incoming()))
      );
      allow delete: if false;
    }

    match /petty_cash/{id} {
      allow list: if isStaff() && sameCompany(resource.data.companyId);
      allow get: if isStaff() && sameCompany(existing().companyId);
      allow create: if isStaff() && sameCompany(incoming().companyId) && isValidPettyCash(incoming());
      allow update: if sameCompany(existing().companyId) && (
        (isAdmin() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isStaff() && isValidPettyCash(incoming()))
      );
      allow delete: if false;
    }
    
    // Test helper
    match /test/connection {
      allow read: if isSignedIn();
    }

    match /_health_check_/ping {
      allow read: if true;
    }
  }
}
