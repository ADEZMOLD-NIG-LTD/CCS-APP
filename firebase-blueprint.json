        "warehouse": { "type": "string" },
        "grossWeight": { "type": "number" },
        "netWeight": { "type": "number" },
        "bags": { "type": "number" },
        "noOfBags": { "type": "number" },
        "pricePerKg": { "type": "number" },
        "totalValue": { "type": "number" },
        "calculationMethod": { "type": "string", "enum": ["DIRECT", "MANUAL"] },
        "deductions": {
          "type": "object",
          "properties": {
            "moistureActual": { "type": "number" },
            "moistureBenchmark": { "type": "number" },
            "tareWeight": { "type": "number" },
            "moldWeight": { "type": "number" },
            "otherDeduction": { "type": "number" }
          }
        },
        "referenceId": { "type": "string" },
        "storeRecordId": { "type": "string" },
        "isDirectDelivery": { "type": "boolean" },
        "truckNo": { "type": "string" },
        "driverName": { "type": "string" },
        "driverPhone": { "type": "string" },
        "staffName": { "type": "string" },
        "notes": { "type": "string" },
        "isDeleted": { "type": "boolean" },
        "deletedBy": { "type": "string" },
        "deletionReason": { "type": "string" },
        "deletedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "date", "type", "commodity", "netWeight", "deductions"]
    },
    "Payment": {
      "title": "Payment",
