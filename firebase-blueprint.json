{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access control and company assignment",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "ACCOUNT", "STAFF", "AUDITOR"] },
        "companyId": { "type": "string" },
        "assignedWarehouseId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "companyId"]
    },
    "StoreRecord": {
      "title": "StoreRecord",
      "description": "Store keeper's independent inventory record for dual control",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["IN", "OUT", "TRANSFER"] },
        "customerName": { "type": "string" },
        "location": { "type": "string" },
        "nominalWeight": { "type": "number" },
        "actualWeight": { "type": "number" },
        "noOfBags": { "type": "number" },
        "moisture": { "type": "number" },
        "tare": { "type": "number" },
        "fieldOfficer": { "type": "string" },
        "truckNo": { "type": "string" },
        "commodity": { "type": "string" },
        "warehouseId": { "type": "string" },
        "sourceWarehouseId": { "type": "string" },
        "destinationWarehouseId": { "type": "string" },
        "isDeleted": { "type": "boolean" },
        "deletedBy": { "type": "string" },
        "deletionReason": { "type": "string" },
        "deletedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "date", "type", "customerName", "nominalWeight", "actualWeight", "noOfBags"]
    },
    "Company": {
      "title": "Company",
      "description": "Company information for SaaS multi-tenancy",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerEmail"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Supplier information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
