    "Transaction": {
      "title": "Transaction",
      "description": "Purchase, sale, or transfer of commodities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["PURCHASE", "SALE", "TRANSFER"] },
        "commodity": { "type": "string" },
        "supplierId": { "type": "string" },
        "buyerId": { "type": "string" },
        "buyerName": { "type": "string" },
