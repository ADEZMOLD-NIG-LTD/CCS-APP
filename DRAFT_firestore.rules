rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Helpers
    // ===============================================================
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function getEmail() { return request.auth.token.get('email', '').lower(); }
    
    // Super Admins bypass many checks
    function isSuperAdmin() {
      return isSignedIn() && (
        getEmail() == "wasiuadebisi89@gmail.com" || 
        getEmail() == "adezmoldent@gmail.com" || 
        getEmail() == "abdullahiwasiu07@gmail.com"
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function sameCompany(companyId) {
      return isSignedIn() && (isSuperAdmin() || getUserData().companyId == companyId);
    }

    function isAdmin() {
      return isSignedIn() && (isSuperAdmin() || getUserData().role == 'ADMIN');
    }

    function isManager() {
      return isSignedIn() && (isAdmin() || getUserData().role == 'MANAGER');
    }

    function isAccount() {
      return isSignedIn() && (isManager() || getUserData().role == 'ACCOUNT');
    }

    function isAuditor() {
      return isSignedIn() && (isManager() || getUserData().role == 'AUDITOR');
    }

    function isStaff() {
      return isSignedIn() && (isAccount() || isAuditor() || getUserData().role == 'STAFF' || getUserData().role == 'STORE_KEEPER');
    }

    function isStoreKeeper() {
      return isSignedIn() && (isAdmin() || getUserData().role == 'STORE_KEEPER');
    }

    // Soft delete helper
    function isSoftDelete() {
      return incoming().isDeleted == true && 
             incoming().keys().hasAll(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt']) &&
             incoming().deletionReason is string && incoming().deletionReason.size() > 0 &&
             incoming().deletedBy == getEmail() &&
             incoming().deletedAt is string;
    }

    // ===============================================================
    // Entity Validators (The Blueprints)
    // ===============================================================

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'companyId', 'date', 'type', 'commodity', 'netWeight', 'deductions']) &&
             data.id is string && data.companyId is string &&
             data.type in ['PURCHASE', 'SALE', 'TRANSFER'] &&
             data.commodity is string && data.commodity.size() > 0 &&
             data.netWeight is number && data.netWeight >= 0 &&
             data.deductions is map;
    }

    function isValidJournalEntry(data) {
      return data.keys().hasAll(['id', 'companyId', 'warehouseId', 'date', 'type', 'category', 'amount']) &&
             data.type in ['INFLOW', 'OUTFLOW'] &&
             data.amount is number && data.amount >= 0;
    }

    function isValidStoreRecord(data) {
      return data.keys().hasAll(['id', 'companyId', 'date', 'type', 'customerName', 'nominalWeight', 'actualWeight', 'noOfBags']) &&
             data.type in ['IN', 'OUT', 'TRANSFER'] &&
             data.actualWeight is number && data.actualWeight >= 0;
    }

    function isValidSupplier(data) {
      return data.keys().hasAll(['id', 'companyId', 'name']) &&
             data.name is string && data.name.size() > 0;
    }

    function isValidBuyer(data) {
      return data.keys().hasAll(['id', 'companyId', 'name']) &&
             data.name is string && data.name.size() > 0;
    }

    // ===============================================================
    // Match Blocks
    // ===============================================================

    match /companies/{companyId} {
      allow read: if sameCompany(companyId);
      allow create: if isSuperAdmin() || (isSignedIn() && incoming().ownerEmail == getEmail());
      allow update: if isAdmin() && sameCompany(companyId);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().role == existing().role) ||
        (isAdmin() && sameCompany(existing().companyId))
      );
    }

    match /transactions/{id} {
      allow list: if isStaff() && sameCompany(incoming().companyId); // Enforced query
      allow get: if isStaff() && sameCompany(existing().companyId);
      allow create: if isStaff() && sameCompany(incoming().companyId) && isValidTransaction(incoming());
      allow update: if sameCompany(existing().companyId) && (
        (isAdmin() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isStaff() && isValidTransaction(incoming()))
      );
      allow delete: if false; // Prefer soft delete
    }

    match /journal/{id} {
      allow list: if isAccount() && sameCompany(incoming().companyId);
      allow get: if isAccount() && sameCompany(existing().companyId);
      allow create: if isAccount() && sameCompany(incoming().companyId) && isValidJournalEntry(incoming());
      allow update: if sameCompany(existing().companyId) && (
        (isAdmin() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isAccount() && isValidJournalEntry(incoming()))
      );
      allow delete: if false;
    }

    match /payments/{id} {
      allow read: if isStaff() && sameCompany(existing().companyId);
      allow create: if isAccount() && sameCompany(incoming().companyId);
      allow update: if sameCompany(existing().companyId) && (
        (isAdmin() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isAccount())
      );
    }

    match /bag_transactions/{id} {
      allow read: if isStaff() && sameCompany(existing().companyId);
      allow create: if isStaff() && sameCompany(incoming().companyId);
      allow update: if sameCompany(existing().companyId) && (
        (isAdmin() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isStaff())
      );
    }

    match /suppliers/{id} {
      allow read: if isStaff() && sameCompany(existing().companyId);
      allow create: if isStaff() && sameCompany(incoming().companyId) && isValidSupplier(incoming());
      allow update: if sameCompany(existing().companyId) && (
        (isAdmin() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isStaff() && isValidSupplier(incoming()))
      );
    }

    match /buyers/{id} {
      allow read: if isStaff() && sameCompany(existing().companyId);
      allow create: if isStaff() && sameCompany(incoming().companyId) && isValidBuyer(incoming());
      allow update: if sameCompany(existing().companyId) && (
        (isAdmin() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isStaff() && isValidBuyer(incoming()))
      );
    }

    match /store_records/{id} {
      allow read: if (isStoreKeeper() || isManager()) && sameCompany(existing().companyId);
      allow create: if isStoreKeeper() && sameCompany(incoming().companyId) && isValidStoreRecord(incoming());
      allow update: if sameCompany(existing().companyId) && (
        (isManager() && isSoftDelete() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'deletionReason', 'deletedBy', 'deletedAt'])) ||
        (!existing().get('isDeleted', false) && isStoreKeeper() && isValidStoreRecord(incoming()))
      );
    }

    match /staff/{id} {
      allow read: if isManager() && sameCompany(existing().companyId);
      allow create: if isManager() && sameCompany(incoming().companyId);
      allow update: if isManager() && sameCompany(existing().companyId);
    }

    match /audit_logs/{id} {
      allow list: if (isManager() || isAuditor()) && sameCompany(incoming().companyId);
      allow create: if isSignedIn() && sameCompany(incoming().companyId);
    }
    
    // Test helper
    match /test/connection {
      allow read: if isSignedIn();
    }
  }
}
