# -----------------------------------------------------------------------------
# Web app (read at build time and embedded in the browser bundle — nothing secret here)
# -----------------------------------------------------------------------------
VITE_APP_ENV="development" # development | staging | production
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
VITE_SUPPORT_EMAIL="support@example.com"

# Only for a demo-only bundle without Firebase. Never set this for staging or production.
# VITE_ALLOW_MOCK_BUILD="true"

# -----------------------------------------------------------------------------
# API server (server.ts) — keep these out of the web build and out of git
# -----------------------------------------------------------------------------
PORT="3000"
APP_URL="https://commodityclick.com.ng"

# Firebase Admin. On Cloud Run leave FIREBASE_SERVICE_ACCOUNT empty and grant the runtime
# service account the "Firebase Authentication Viewer" and "Cloud Datastore User" roles.
# Locally, either paste a service-account JSON on one line or set GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=""
FIREBASE_FIRESTORE_DATABASE_ID="(default)"
FIREBASE_SERVICE_ACCOUNT=""
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"

# SMTP for invitation emails (Gmail requires an App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Paystack. Server-side only: this key can move money, so it must never be given a VITE_
# prefix, which would compile it into the browser bundle. Use sk_test_... until the flow is
# proven, then sk_live_... In production it comes from Secret Manager, not from this file.
# The browser never holds a Paystack key: checkout happens on Paystack's own page.
PAYSTACK_SECRET_KEY=""
